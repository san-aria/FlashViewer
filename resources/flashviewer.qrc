<RCC>
  <qresource prefix="/themes">
    <file alias="light.qss">themes/light.qss</file>
    <file alias="dark.qss">themes/dark.qss</file>
  </qresource>
  <qresource prefix="/icons">
    <file alias="arrow_up_dark.svg">icons/arrow_up_dark.svg</file>
    <file alias="arrow_down_dark.svg">icons/arrow_down_dark.svg</file>
    <file alias="arrow_up_light.svg">icons/arrow_up_light.svg</file>
    <file alias="arrow_down_light.svg">icons/arrow_down_light.svg</file>
    <file alias="dock_close_dark.svg">icons/dock_close_dark.svg</file>
    <file alias="dock_close_light.svg">icons/dock_close_light.svg</file>
    <file alias="dock_float_dark.svg">icons/dock_float_dark.svg</file>
    <file alias="dock_float_light.svg">icons/dock_float_light.svg</file>
  </qresource>
</RCC>
